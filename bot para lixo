@bot.command()
async def comandos(ctx:commands.Context):
    minha_embed = discord.Embed()
    minha_embed.title = 'nossos comandos'
    minha_embed.description = 'temos os seguintes codigos: $oi, $bye, $genpass, $coin, $smile. $oi: ele envia uma mensagem de olá $bye: envia uma mensagem de tchau $genpass: cria uma senha $coin: tira cara ou coroa $smile: sorteia um emoji'
    
    await ctx.reply(embed=minha_embed)
@bot.command()
async def oi(ctx:commands.Context):
    name = ctx.author.mention
    await ctx.reply(f'olá {name}')



@bot.command()
async def tchau(ctx:commands.Context):
    await ctx.reply(f'até mais {ctx.author.name}')


@bot.command()
async def genpass(ctx:commands.Context, tamanho: int = 10):
    senha = gen_pass(tamanho)
    await ctx.reply(f"Sua senha é: {senha}")


@bot.command()
async def coin(ctx:commands.Context):
    await ctx.reply(flip_coin())


@bot.command()
async def smile(ctx):
    await ctx.reply(gen_emoji())



